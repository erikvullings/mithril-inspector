{
  "name": "@mithril-inspector/overlay",
  "version": "0.3.2",
  "description": "The in-page inspector UI for Mithril Inspector — element picker, highlight overlay and source tooltip.",
  "type": "module",
  "license": "MIT",
  "author": "Erik Vullings",
  "homepage": "https://github.com/erikvullings/mithril-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-inspector.git",
    "directory": "packages/overlay"
  },
  "bugs": "https://github.com/erikvullings/mithril-inspector/issues",
  "keywords": [
    "mithril",
    "mithril.js",
    "devtools",
    "inspector",
    "overlay"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mithril-inspector/protocol": "workspace:*",
    "mithril": "^2.3.8"
  },
  "devDependencies": {
    "@mithril-inspector/runtime": "workspace:*",
    "@types/mithril": "^2.2.9",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}