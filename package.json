{
  "name": "mithril-inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter @mithril-inspector/browser-tests test",
    "typecheck": "pnpm -r typecheck",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs patch --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
