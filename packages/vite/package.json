{
  "name": "@mithril-inspector/vite",
  "version": "0.1.0",
  "description": "Zero-config Vite plugin for Mithril Inspector — combines the transform, runtime, overlay and server packages.",
  "type": "module",
  "license": "MIT",
  "author": "Erik Vullings",
  "homepage": "https://github.com/erikvullings/mithril-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-inspector.git",
    "directory": "packages/vite"
  },
  "bugs": "https://github.com/erikvullings/mithril-inspector/issues",
  "keywords": ["mithril", "mithril.js", "devtools", "inspector", "vite", "vite-plugin"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@mithril-inspector/overlay": "workspace:*",
    "@mithril-inspector/protocol": "workspace:*",
    "@mithril-inspector/runtime": "workspace:*",
    "@mithril-inspector/server": "workspace:*",
    "@mithril-inspector/transform": "workspace:*"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/mithril": "^2.2.8",
    "@types/node": "^24.0.14",
    "mithril": "^2.3.8",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
