{
  "name": "mithril-inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter @mithril-inspector/browser-tests test",
    "typecheck": "pnpm -r typecheck",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs patch --dry-run",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "puppeteer": "^25.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}