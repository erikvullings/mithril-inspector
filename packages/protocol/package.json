{
  "name": "@mithril-inspector/protocol",
  "version": "0.3.1",
  "description": "Shared serializable types and protocol constants for Mithril Inspector, with no bundler dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Erik Vullings",
  "homepage": "https://github.com/erikvullings/mithril-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-inspector.git",
    "directory": "packages/protocol"
  },
  "bugs": "https://github.com/erikvullings/mithril-inspector/issues",
  "keywords": [
    "mithril",
    "mithril.js",
    "devtools",
    "inspector",
    "protocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}