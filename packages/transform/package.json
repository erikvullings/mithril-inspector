{
  "name": "@mithril-inspector/transform",
  "version": "0.3.2",
  "description": "Bundler-neutral AST source instrumentation for Mithril Inspector component detection.",
  "type": "module",
  "license": "MIT",
  "author": "Erik Vullings",
  "homepage": "https://github.com/erikvullings/mithril-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-inspector.git",
    "directory": "packages/transform"
  },
  "bugs": "https://github.com/erikvullings/mithril-inspector/issues",
  "keywords": [
    "mithril",
    "mithril.js",
    "devtools",
    "inspector",
    "ast",
    "source-transform"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@mithril-inspector/protocol": "workspace:*",
    "@rollup/pluginutils": "^5.4.0",
    "magic-string": "^1.0.0"
  },
  "devDependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@babel/types": "^8.0.4",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/mithril": "^2.2.8",
    "esbuild": "^0.28.1",
    "mithril": "^2.3.8",
    "vitest": "^4.1.10"
  }
}