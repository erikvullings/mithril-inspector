{
  "name": "@mithril-inspector/esbuild",
  "version": "0.2.1",
  "description": "The esbuild integration for Mithril Inspector — a thin adapter over the shared transform, runtime and server packages (§4, §12.4).",
  "type": "module",
  "license": "MIT",
  "author": "Erik Vullings",
  "homepage": "https://github.com/erikvullings/mithril-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-inspector.git",
    "directory": "packages/esbuild"
  },
  "bugs": "https://github.com/erikvullings/mithril-inspector/issues",
  "keywords": [
    "mithril",
    "mithril.js",
    "devtools",
    "inspector",
    "esbuild",
    "esbuild-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "esbuild": ">=0.17.0"
  },
  "dependencies": {
    "@mithril-inspector/adapter-kit": "workspace:*",
    "@mithril-inspector/overlay": "workspace:*",
    "@mithril-inspector/protocol": "workspace:*",
    "@mithril-inspector/runtime": "workspace:*",
    "@mithril-inspector/server": "workspace:*",
    "@mithril-inspector/transform": "workspace:*"
  },
  "devDependencies": {
    "@types/mithril": "^2.2.8",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "mithril": "^2.3.8",
    "vitest": "^4.1.10"
  }
}