{
  "name": "@mithril-inspector/runtime",
  "version": "0.3.0",
  "description": "Runtime source registry, component registry and lifecycle-hook composition for Mithril Inspector.",
  "type": "module",
  "license": "MIT",
  "author": "Erik Vullings",
  "homepage": "https://github.com/erikvullings/mithril-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-inspector.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/erikvullings/mithril-inspector/issues",
  "keywords": [
    "mithril",
    "mithril.js",
    "devtools",
    "inspector",
    "runtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mithril-inspector/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/mithril": "^2.2.8",
    "jsdom": "^29.1.1",
    "mithril": "^2.3.8",
    "vitest": "^4.1.10"
  }
}